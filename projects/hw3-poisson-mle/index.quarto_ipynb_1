  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "poisson-reg-loglike",
   "metadata": {},
   "outputs": [],
   "source": [
    "#| label: poisson-reg-loglike\n",
    "#| echo: false\n",
    "#| output: false\n",
    "\n",
    "def poisson_regression_loglikelihood(beta, Y, X):\n",
    "    eta = X @ beta\n",
    "    lam = np.exp(eta)\n",
    "    return np.sum(Y * eta - lam - gammaln(Y + 1))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "poisson-reg-mle",
   "metadata": {},
   "outputs": [],
   "source": [
    "#| label: poisson-reg-mle\n",
    "#| echo: false\n",
    "#| output: false\n",
    "\n",
    "def neg_poisson_regression_loglikelihood(beta, Y, X):\n",
    "    return -poisson_regression_loglikelihood(beta, Y, X)\n",
    "\n",
    "beta0 = np.zeros(X_mat.shape[1])\n",
    "beta0[0] = np.log(Y.mean())\n",
    "\n",
    "opt_result = minimize(\n",
    "    neg_poisson_regression_loglikelihood,\n",
    "    x0=beta0,\n",
    "    args=(Y, X_mat),\n",
    "    method=\"BFGS\"\n",
    ")\n",
    "\n",
    "beta_hat = opt_result.x"
   ]

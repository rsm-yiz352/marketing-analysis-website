   "source": [
    "#| label: build-x\n",
    "#| echo: false\n",
    "#| output: false\n",
    "\n",
    "X = pd.get_dummies(df[\"region\"], prefix=\"region\", drop_first=True, dtype=int)\n",
    "X[\"age\"] = df[\"age\"]\n",
    "X[\"age_sq\"] = df[\"age\"] ** 2\n",
    "X[\"iscustomer\"] = df[\"iscustomer\"]\n",
    "\n",
    "X = sm.add_constant(X)\n",
    "\n",
    "ordered_cols = [\"const\", \"age\", \"age_sq\"] + [c for c in X.columns if c.startswith(\"region_\")] + [\"iscustomer\"]\n",
    "X = X[ordered_cols]\n",
    "\n",
    "Y = df[\"patents\"].to_numpy(dtype=float)\n",
    "X_mat = X.to_numpy(dtype=float)\n",
    "\n",
    "print(X.head())\n",
    "print(X.shape)"
   ]
